# Copy this file to .env.s3 and supply your real credentials. NEVER commit .env.s3.
AWS_STORAGE_BUCKET_NAME=your-private-pulp-bucket
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# Optional for temporary STS credentials:
# AWS_SESSION_TOKEN=replace-me
